# Address of the cus-reporting web backend (Next.js + MongoDB) this app talks to.
# A phone can't reach "localhost": use your computer's LAN address (e.g. http://192.168.1.20:3000),
# or http://10.0.2.2:3000 for the Android emulator, or the deployed https:// URL.
# Copy this file to .env.local (git-ignored) and restart the app after changing it.

EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Web app (PWA) only: the public key of the VAPID pair (see cus-reporting/.env.example) so admin alerts can
# reach iPhones. Leave empty to turn those alerts off. The web build needs no EXPO_PUBLIC_API_URL: it calls
# /api on its own address, which vercel.json forwards to the backend.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
